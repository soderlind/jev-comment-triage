{
	"name": "soderlind/jev-comment-triage",
	"description": "Async Jev-powered comment triage for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"soderlind/wordpress-github-updater": "^2.0"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"pestphp/pest": "^4.0",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"scripts": {
		"test": "pest",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.3.0"
		},
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
